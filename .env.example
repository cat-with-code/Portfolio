# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# The same names go into Vercel → Project → Settings → Environment Variables.

# ── Supabase (supabase.com → your project → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses every security rule. Used only by the one-time import script and the contact form.
# Never prefix with NEXT_PUBLIC_, never paste it anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 for music files (dash.cloudflare.com → R2). Server only: the browser gets short-lived upload links. ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-audio
# Public URL of the bucket (R2 → bucket → Settings → Public access), e.g. https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Contact form email (optional, resend.com) ──
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# ── Owner: your Supabase user id (Authentication → Users → your row → UID). Not secret, but only this user may write. ──
OWNER_USER_ID=

# ── Daily keep-awake job: any long random string (e.g. `openssl rand -hex 32`). Server only. ──
CRON_SECRET=

# ── Dashboard: keep false until login is working ──
DASHBOARD_ENABLED=false

# ── Public address of the site (for search engines and share previews), e.g. https://yourname.com
# Leave empty on Vercel to use its production address automatically.
NEXT_PUBLIC_SITE_URL=

# ── Dashboard session limits (optional; defaults 30 min without activity, 12 h maximum). Set small values to test.
# DASHBOARD_IDLE_MINUTES=30
# DASHBOARD_MAX_HOURS=12

# ── Google Search Console: the code from "HTML tag" verification (only the content="…" part). Public, not a secret.
GOOGLE_SITE_VERIFICATION=
